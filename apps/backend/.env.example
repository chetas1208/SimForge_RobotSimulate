# SimForge Backend Environment
APP_ENV=development
DATABASE_URL=sqlite:///./simforge.db
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=./storage
SIMULATION_PROVIDER=track4
TRACK4_MODEL_DIR=./models/warehouse-risk-binary-20260418182317
TRACK4_SCENARIO_CONFIG=./apps/simulator/configs/warehouse_blind_corner.yaml
XGBOOST_DEVICE=cuda:0
SECRET_KEY=simforge-dev-secret-change-in-production
ENABLE_DEMO_SEED=false

# Preview Generation
PREVIEW_PROVIDER=seedance
LLM_PROVIDER=nvidia_nim

# NVIDIA NIM API (for LLM prompt enhancement)
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_NIM_USD_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Seedance API (for video generation)
SEEDANCE_API_KEY=your-seedance-api-key-here
SEEDANCE_BASE_URL=https://api.seedance.ai/v1

# HPC / Isaac Sim (optional — only needed for real simulation)
HPC_HOST=
HPC_USER=
HPC_WORKDIR=/scratch/simforge
ISAAC_RESULTS_DIR=/scratch/simforge/results
ISAAC_SIM_PATH=
ISAAC_PYTHON=
ISAAC_LD_LIBRARY_PATH=
ISAAC_EXTRA_ARGS=
ISAAC_HEADLESS=true
